{
  "version": 1,
  "description": "Broker CSV import contract shared by backend/importers.py and the Kotlin :importers module. Each case is a real export shape; 'expected' is asserted by tests/test_importer_spec.py and android-app/importers/src/test/.../ImporterSpecTest.kt. Operations are compared by resolved names and tickers, never by generated ids.",
  "baseCurrency": "PLN",
  "cases": [
    {
      "name": "generic-clean-buy",
      "why": "Baseline: the layout the app itself exports. The fee arrives negative, as money leaving the account, and must be stored as a magnitude — everything downstream does 'cash -= amount + fee'.",
      "broker": "generic",
      "csv": "date;type;ticker;quantity;price;fee;currency\n2026-03-01;Kupno;CDR;10;100;-1,50;PLN\n",
      "portfolios": [
        {
          "id": "ptf_1",
          "name": "Glowny"
        }
      ],
      "accounts": [
        {
          "id": "acc_1",
          "name": "Konto"
        }
      ],
      "assets": [],
      "options": {
        "portfolioId": "ptf_1",
        "accountId": "acc_1"
      },
      "expected": {
        "rowCount": 1,
        "importedCount": 1,
        "created": {
          "assets": 1,
          "accounts": 0,
          "portfolios": 0
        },
        "operations": [
          {
            "date": "2026-03-01",
            "type": "Kupno waloru",
            "portfolio": "Glowny",
            "account": "Konto",
            "assetTicker": "CDR",
            "targetAssetTicker": "",
            "quantity": 10.0,
            "targetQuantity": 0.0,
            "price": 100.0,
            "amount": 1000.0,
            "fee": 1.5,
            "currency": "PLN",
            "tags": [],
            "note": ""
          }
        ]
      }
    },
